{
  "name": "project-template",
  "version": "4.0.0",
  "description": "PenguinTech project template with multi-language support",
  "main": "web/src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "cd web && npm run dev",
    "dev:api": "nodemon web/src/server.js",
    "build": "npm run build:web",
    "build:web": "cd web && npm run build",
    "start": "node web/src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t project-template:latest .",
    "docker:run": "docker run -p 3000:3000 project-template:latest",
    "license:validate": "node scripts/validate-license.js",
    "version:update": "./scripts/version/update-version.sh"
  },
  "dependencies": {
    "@penguintechinc/react-libs": "1.3.4",
    "axios": "1.21.1",
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "joi": "18.3.2",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "redis": "6.3.1",
    "winston": "3.19.0",
    "wrangler": "4.166.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/bcryptjs": "3.0.0",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-node": "11.1.0",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "prettier": "3.10.1",
    "puppeteer": "25.18.1",
    "supertest": "7.3.2",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "keywords": [
    "penguintech",
    "template",
    "enterprise",
    "licensing",
    "multi-language"
  ],
  "author": "Penguin Tech Inc",
  "license": "Proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/penguintechinc/project-template"
  },
  "bugs": {
    "url": "https://github.com/penguintechinc/project-template/issues"
  },
  "overrides": {
    "basic-ftp": "6.2.4",
    "qs": "6.16.2",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "body-parser": "1.20.9",
    "follow-redirects": "1.16.2",
    "@penguintechinc/react-libs": {
      "zod": "4.6.6"
    }
  }
}
