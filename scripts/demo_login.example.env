# Demo login written by `make seed-demo` (see docs/demo-data.md).
# Local-development values only — they are the defaults baked into
# scripts/demo_seed/common.py. Override DEMO_ADMIN_PASSWORD for any shared
# or production-like environment (the seeder refuses the default when
# ELDER_ENV/QUART_ENV/FLASK_ENV/APP_ENV is "production"). Reserved example.com
# domain: no real mailbox. Tooling (e.g. the screenshot capture) can source this
# file; the login is tenant-less and resolves to the system/default tenant.
DEMO_ADMIN_EMAIL=demo-admin@example.com
DEMO_ADMIN_PASSWORD=demo-local-only-1
